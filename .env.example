# === Data providers ===
# OANDA (live trading account)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# Twelve Data (https://twelvedata.com) — free tier: 800 req/day
TWELVE_DATA_API_KEY=

# Alpha Vantage (https://alphavantage.co) — free tier: 25 req/day
ALPHA_VANTAGE_API_KEY=

# === AI / LLM ===
# Google Gemini — news classification + CB statement analysis
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# === Optional: Economic calendar ===
TRADING_ECONOMICS_API_KEY=

# === Auth ===
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=fx_signal.db

# === App settings ===
DEBUG=false
STRONG_BUY_THRESHOLD=80
WATCH_THRESHOLD=65
